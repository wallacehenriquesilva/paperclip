DATABASE_URL=postgres://paperclip:paperclip@localhost:5432/paperclip
PORT=3100
SERVE_UI=false
BETTER_AUTH_SECRET=paperclip-dev-secret

# Restrict who can sign up.
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=true            # block all new account creation
# PAPERCLIP_AUTH_ALLOWED_EMAIL_DOMAINS=contaazul.com,example.com  # only these email domains may sign up (empty = any)
#
# SSO (OIDC, Google Workspace by default). Redirect URI to register at the IdP:
#   <public base url>/api/auth/oauth2/callback/<PAPERCLIP_AUTH_OIDC_PROVIDER_ID>
# PAPERCLIP_AUTH_OIDC_ENABLED=true
# PAPERCLIP_AUTH_OIDC_CLIENT_ID=xxxx.apps.googleusercontent.com
# PAPERCLIP_AUTH_OIDC_CLIENT_SECRET=xxxx
# PAPERCLIP_AUTH_OIDC_REQUIRED_HD=example.com       # Google Workspace domain; enforced on the id_token `hd` claim
# PAPERCLIP_AUTH_OIDC_LABEL=Google                  # button text: "Sign in with <label>"
# PAPERCLIP_AUTH_OIDC_PROVIDER_ID=oidc              # part of the redirect URI
# PAPERCLIP_AUTH_OIDC_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# PAPERCLIP_AUTH_OIDC_AUTO_PROVISION=true           # create users on first SSO sign-in (domain allowlist still applies)
# PAPERCLIP_AUTH_OIDC_DEFAULT_COMPANY_ID=           # company new SSO users join (empty = none)
# PAPERCLIP_AUTH_OIDC_DEFAULT_ROLE=viewer           # owner | admin | operator | viewer
# PAPERCLIP_AUTH_PASSWORD_LOGIN=enabled             # "disabled" = SSO only (requires OIDC)
# PAPERCLIP_AUTH_BREAK_GLASS_EMAILS=admin@example.com  # may still use a password when it is disabled
# PAPERCLIP_AUTH_SESSION_TTL_HOURS=168

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
